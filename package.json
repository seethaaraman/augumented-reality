{
  "name": "ar-restaurant-root",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "build": "npm --prefix frontend run build",
    "build:frontend": "npm --prefix frontend run build",
    "cap:sync": "npm --prefix frontend run cap:sync",
    "cap:open": "npm --prefix frontend run cap:open",
    "install:all": "npm install && npm --prefix frontend install && npm --prefix backend install"
  },
  "dependencies": {
    "@gradio/client": "^2.7.1",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^18.0.4",
    "express": "^4.21.2",
    "ffmpeg-static": "^5.3.0",
    "mongoose": "^8.23.0",
    "multer": "^2.4.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
